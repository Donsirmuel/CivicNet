# CivicNet VPS secrets (NEVER commit this file — copy to .env.vps and fill in)
# Postgres runs inside the stack (db service, data in ./data/postgres) —
# no external database URL needed. Django still uses SQLite for local dev.
POSTGRES_DB=civicnet
POSTGRES_USER=civicnet
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Django
SECRET_KEY=change-me-to-a-long-random-secret

# Public origin of the site (domain or http://VPS-IP). Comma-separated if several.
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=

# Same-origin API via the nginx proxy; keep /api unless you split hosts.
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Host port for the site.
HTTP_PORT=80
# Set True only when TLS terminates in front (nginx-proxy, Caddy...).
SECURE_SSL_REDIRECT=False
