# Backend Environment Variables

# Django Settings
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=*.railway.app,localhost,127.0.0.1

# Database (PostgreSQL)
# Railway will provide DATABASE_URL automatically, or use external Postgres (Neon, etc.)
DATABASE_URL=postgresql://user:password@host:5432/civicnet_db

# CORS (Frontend URL from Vercel)
# Example: https://civicnet.vercel.app
CORS_ALLOWED_ORIGINS=https://your-vercel-domain.vercel.app,http://localhost:5173

# CSRF (same as CORS)
CSRF_TRUSTED_ORIGINS=https://your-vercel-domain.vercel.app,http://localhost:5173

# Python Version (optional)
PYTHON_VERSION=3.12.3

# Google OAuth (Sign-In token verification; same client id as VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
