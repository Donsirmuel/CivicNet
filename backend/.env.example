# Backend Environment Variables (local dev: copy to backend/civic_connect/.env)

# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL on the VPS via docker-compose; blank = local SQLite)
# Example: postgres://civicnet:password@db:5432/civicnet
DATABASE_URL=

# CORS/CSRF — same-origin through the nginx proxy on the VPS, so these only
# matter for local dev (Vite on :5173) or split-host setups.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set True in production only when TLS terminates in front.
SECURE_SSL_REDIRECT=False

# Google OAuth (Sign-In token verification; same client id as VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
